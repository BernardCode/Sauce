# Supabase project URL, Project Settings, Data API
NEXT_PUBLIC_SUPABASE_URL=
# Publishable key (sb_publishable_...), safe for the browser, RLS enforces access
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only Supabase key used by cron and encrypted source sync
SUPABASE_SERVICE_ROLE_KEY=
# Google OAuth client credentials used to refresh Calendar access
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Base64-encoded 32-byte key for AES-256 source credential encryption
SOURCE_SECRET_KEY=
# Random bearer secret checked by the Vercel sync cron route
CRON_SECRET=
